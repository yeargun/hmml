{
  "name": "@eddocu/hmml",
  "version": "0.2.0",
  "description": "HMML: blueprint-first streaming binary documents with bounded media chunks, worker support, and zero runtime dependencies.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./mount": {
      "types": "./dist/mount.d.ts",
      "import": "./dist/mount.js",
      "require": "./dist/mount.cjs"
    },
    "./encode": {
      "types": "./dist/encode.d.ts",
      "import": "./dist/encode.js",
      "require": "./dist/encode.cjs"
    },
    "./decode": {
      "types": "./dist/decode.d.ts",
      "import": "./dist/decode.js",
      "require": "./dist/decode.cjs"
    },
    "./encode-stream": {
      "types": "./dist/encode-stream.d.ts",
      "import": "./dist/encode-stream.js",
      "require": "./dist/encode-stream.cjs"
    },
    "./decode-stream": {
      "types": "./dist/decode-stream.d.ts",
      "import": "./dist/decode-stream.js",
      "require": "./dist/decode-stream.cjs"
    },
    "./codecs": {
      "types": "./dist/codecs.d.ts",
      "import": "./dist/codecs.js",
      "require": "./dist/codecs.cjs"
    },
    "./markup": {
      "types": "./dist/markup.d.ts",
      "import": "./dist/markup.js",
      "require": "./dist/markup.cjs"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "import": "./dist/worker.js",
      "require": "./dist/worker.cjs"
    },
    "./pack": {
      "types": "./dist/pack.d.ts",
      "import": "./dist/pack.js",
      "require": "./dist/pack.cjs"
    },
    "./decode/direct": {
      "types": "./dist/decode-direct.d.ts",
      "import": "./dist/decode-direct.js",
      "require": "./dist/decode-direct.cjs"
    },
    "./decode-stream/direct": {
      "types": "./dist/decode-stream-direct.d.ts",
      "import": "./dist/decode-stream-direct.js",
      "require": "./dist/decode-stream-direct.cjs"
    },
    "./decoder": {
      "types": "./dist/decoder.d.ts",
      "import": "./dist/decoder.js",
      "require": "./dist/decoder.cjs"
    },
    "./worker-entry": {
      "types": "./dist/decode-worker.d.ts",
      "import": "./dist/decode-worker.js",
      "require": "./dist/decode-worker.cjs"
    },
    "./frame": {
      "types": "./dist/frame.d.ts",
      "import": "./dist/frame.js",
      "require": "./dist/frame.cjs"
    }
  },
  "files": [
    "dist",
    "SPEC.md",
    "README.md",
    "docs/streaming.md",
    "docs/performance.md",
    "docs/workers.md",
    "docs/rendering.md"
  ],
  "sideEffects": [
    "./dist/decode-worker.js",
    "./dist/decode-worker.cjs",
    "./dist/decode-worker.global.js"
  ],
  "scripts": {
    "build": "tsup",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "demo": "tsx examples/roundtrip.ts",
    "pg:build": "npm run build && node playground/build.mjs",
    "pg:bundle": "npm run pg:build && node playground/bundle.mjs",
    "playground": "npm run pg:build && node e2e/server.mjs",
    "bench": "npm run build && node bench/perf.mjs",
    "size": "npm run build && node bench/size.mjs",
    "site:build": "npm run build && node docs/build.mjs",
    "site:deploy": "npm run site:build && npx wrangler pages deploy site --project-name=hmml",
    "test": "vitest run",
    "test:browser": "npm run build && playwright test",
    "test:all": "npm run test && npm run build && node --test test/package-bundles.mjs && playwright test",
    "bench:stream": "npm run build && node bench/stream.mjs",
    "bench:compression": "npm run build && node bench/compression.mjs",
    "bench:workers": "npm run build && node bench/workers.mjs",
    "test:package": "npm run build && node --test test/package-bundles.mjs"
  },
  "keywords": [
    "hmml",
    "binary",
    "html",
    "image",
    "container",
    "webp",
    "format",
    "hypermedia"
  ],
  "author": "Argun",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeargun/hmml.git"
  },
  "homepage": "https://hmml.eddocu.com",
  "bugs": {
    "url": "https://github.com/yeargun/hmml/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@playwright/test": "1.57.0",
    "terser": "^5.31.0",
    "@types/node": "^20.12.7",
    "highlight.js": "^11.9.0",
    "marked": "^12.0.2",
    "marked-highlight": "^2.1.1",
    "tsup": "^8.0.2",
    "tsx": "^4.7.1",
    "typescript": "^5.4.5",
    "vitest": "^1.5.0"
  }
}
